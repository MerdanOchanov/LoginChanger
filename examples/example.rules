# Пример файла правил описаний (необязательная функция). Кодировка UTF-8.
# Разделы: [strip] [entities] [tags] [exact] [rules] [rules_other] [extras] [fallback]
# В шаблонах: {1} — группа регулярного выражения, {g1} — группа через глоссарий, {?1: текст} — только если группа 1 не пуста.

[strip]
RPT_

[entities]
ALL = все филиалы вместе
NORTH = северный филиал
SOUTH = южный филиал

[tags]
_OLD = архивная копия
_TEMP = временная копия

[exact]
V_PATIENTS = Пациенты: карточки и контакты

[rules]
^SALES => Продажи по клиентам и менеджерам
^REVENUE_MONTHLY => Выручка по месяцам
^STOCK => Остатки товаров по складам

[rules_other]
^V_VISITS => Журнал приёмов по врачам и датам

[extras]
_(20\d\d)(?:_|$) => " за {1} г."

[fallback]
prefixed = Отчёт: {rest}
other = Выборка данных